GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash
LOG_LEVEL=INFO

# Postgres. Choose any password; docker compose uses it to create the database.
POSTGRES_PASSWORD=choose-a-password
# Used when running the API directly (uv run ...), e.g. against a postgres container on localhost.
# Docker compose ignores this and connects to its own "db" service.
DATABASE_URL=postgresql://llmuser:choose-a-password@localhost:5432/llmdb
