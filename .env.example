# ---- Model ----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash

# ---- Logging / cache --------------------------------------------------------------------
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=3600

# ---- Docker Compose (the backend reaches the services as "postgres" and "redis") ------------
POSTGRES_USER=qa_user
POSTGRES_PASSWORD=choose-a-password
POSTGRES_DB=qa_db

# ---- Running the API directly on your machine (uv run uvicorn ...) -------------------------
# Not used by Docker Compose. Point these at databases reachable from your machine.
DATABASE_URL=postgresql://qa_user:choose-a-password@localhost:5432/qa_db
REDIS_URL=redis://localhost:6379/0
